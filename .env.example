# ---------------------------------------------------------------------------
# Configuracoes da aplicacao - copie este arquivo para ".env" e ajuste
# ---------------------------------------------------------------------------
# O .env NAO deve ser versionado (ver .gitignore). Em deploy, cadastre estas
# variaveis no painel da hospedagem em vez de enviar o arquivo.

# Ambiente: development (padrao) | production | testing
# Em producao, define ProductionConfig (sem debug e com SECRET_KEY obrigatoria).
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=1

# Chave usada para assinar sessoes/cookies. Em producao, gere uma aleatoria:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao

# Porta do "python app.py" local. Em producao quem define e a hospedagem (PORT).
PORT=5000

# --- Banco de dados: opcao 1 (partes separadas) -----------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mente_saudavel
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_CONNECT_TIMEOUT=5

# --- Banco de dados: opcao 2 (string unica) --------------------------------
# Se definida, tem prioridade sobre DB_HOST/DB_PORT/... e ja inclui sslmode.
# E o formato entregue por Render, Railway, Supabase, Neon e Heroku.
# DATABASE_URL=postgresql://usuario:senha@host:5432/mente_saudavel?sslmode=require

# --- CORS ------------------------------------------------------------------
# "*" libera qualquer origem (uso local). Em producao, deixe vazio (o painel e
# servido pela propria aplicacao) ou liste as origens permitidas separadas por
# virgula: CORS_ORIGINS=https://painel.exemplo.com,https://admin.exemplo.com
CORS_ORIGINS=*
