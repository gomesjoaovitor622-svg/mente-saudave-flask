# ---------------------------------------------------------------------------
# Configuracoes da aplicacao - copie este arquivo para ".env" e ajuste
# ---------------------------------------------------------------------------
# O .env NAO deve ser versionado (ver .gitignore).

# Ambiente: development (padrao) | production | testing
APP_ENV=development
FLASK_DEBUG=1

# Chave usada para assinar sessoes/cookies. Troque por uma valor proprio.
SECRET_KEY=troque-esta-chave

# Porta do "python app.py".
PORT=5000

# --- Banco de dados ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mente_saudavel
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_CONNECT_TIMEOUT=5

# --- CORS ------------------------------------------------------------------
# "*" libera qualquer origem (uso local). Liste origens separadas por virgula
# se o front-end estiver em outro dominio.
CORS_ORIGINS=*
