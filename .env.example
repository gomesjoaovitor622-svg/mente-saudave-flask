# ---------------------------------------------------------------------------
# Configuracoes da aplicacao - copie este arquivo para ".env" e ajuste
# ---------------------------------------------------------------------------
# O .env NAO deve ser versionado (ver .gitignore).

# Liga/desliga o modo de depuracao do Flask (1 = ligado).
FLASK_DEBUG=1

# Porta do "python app.py".
PORT=5000

# --- Banco de dados ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mente_saudavel
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_CONNECT_TIMEOUT=5
