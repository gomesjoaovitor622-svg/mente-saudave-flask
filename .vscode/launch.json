{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: depurar (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Banco: iniciar"
    },
    {
      "name": "API: depurar sem banco local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Testes: validadores (sem banco)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_validators.py", "-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
